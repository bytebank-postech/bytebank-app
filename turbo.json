{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["security-headers.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["JWT_SECRET", "COOKIE_SECURE"]
    },
    "start": {
      "dependsOn": ["build"],
      "passThroughEnv": ["JWT_SECRET", "COOKIE_SECURE"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
